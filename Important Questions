     for(int i = 0 ; i <= arr.length-1; i++)
     {
        if(arr[i] > largest)            //1, 3, 9, 8, 7
        {
            second = largest;           //0, 1, 3, 8,
            largest = arr[i];           //1, 3, 9, 9, 
            
        }
        else if(arr[i]< largest && arr[i] >= second)
        {
            second = arr[i];
            
        }
        
     }
     
     System.out.println(second);
     
    }
}


 //Count character frequency using Map
import java.util.HashMap;
import java.util.Map; 
 class Main {
    public static void main(String[] args)
    {
    
     String mystr = "HAPPY BIRTHDAY TO YOU";
     Map<Character,Integer> mp = new HashMap< Character,Integer>();
     int key = 0;
     for (char c:  mystr.toCharArray())
     {
        int localcharcounter = 0 ;
        System.out.println(c); 
        if(!mp.containsKey(c))
            
            {
            localcharcounter  = localcharcounter + 1;
            mp.put(c,localcharcounter);
            }    
        else if(mp.containsKey(c))
            {
                localcharcounter = mp.get(c);
                localcharcounter = localcharcounter + 1;
                mp.put(c,localcharcounter);
            }
     }
     
     System.out.println(mp);
}
}


